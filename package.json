{
  "name": "glass-ui",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.7.5",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,mts,tsx,json,md,yml,yaml,css,scss,html,astro}": "prettier --write"
  },
  "engines": {
    "node": ">=18"
  },
  "version": "0.0.1"
}
