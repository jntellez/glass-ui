{
  "name": "@glass-ui-kit/glass",
  "version": "0.0.0",
  "private": true,
  "main": "./src/ui/index.ts",
  "module": "./src/ui/index.ts",
  "types": "./src/ui/index.ts",
  "sideEffects": false,
  "scripts": {
    "lint": "tsc --noEmit",
    "build:registry": "bun run ./scripts/build-registry.ts",
    "pretest": "pnpm --filter=@glass-ui-kit/schema build && pnpm build:registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": "./src/ui/index.ts",
    "./css": "./src/css/index.css",
    "./tokens": "./src/css/tokens.css"
  },
  "dependencies": {
    "@glass-ui-kit/schema": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@glass-ui-kit/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "bun-types": "^1.3.6",
    "jsdom": "^29.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
