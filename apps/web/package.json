{
  "name": "glass-ui-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prebuild && astro dev",
    "prebuild": "pnpm --filter=@glass-ui-kit/schema build && pnpm --filter=@glass-ui-kit/glass build:registry",
    "build": "rm -rf .astro && astro build && node ./scripts/assert-customization-build.mjs",
    "preview": "astro preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "6.0.2",
    "@glass-ui-kit/glass": "workspace:*",
    "@glass-ui-kit/schema": "workspace:*",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tailwindcss/typography": "^0.5.19",
    "astro-icon": "^1.1.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/react": "5.0.7",
    "@glass-ui-kit/tsconfig": "workspace:*",
    "@tailwindcss/vite": "4.0.0-alpha.32",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "6.4.4",
    "jsdom": "^29.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.2.3",
    "tailwindcss": "4.0.0-alpha.32",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
