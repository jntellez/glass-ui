---
import { getCollection, render, type CollectionEntry } from "astro:content"
import DocsLayout from "@/layouts/DocsLayout.astro"
import TableOfContents from "@/components/docs/TableOfContents.astro"
import DocsPager from "@/components/docs/DocsPager.astro"
import { H1 } from "@/components/docs/Typography"
import { P } from "@/components/docs/Typography"

export async function getStaticPaths() {
  const docsEntries = await getCollection("docs")

  return docsEntries.map((entry) => {
    let cleanSlug: string | undefined = entry.id

    cleanSlug = cleanSlug.replace(/\.mdx?$/, "")

    if (cleanSlug.endsWith("/index")) {
      cleanSlug = cleanSlug.replace(/\/index$/, "")
    } else if (cleanSlug === "index") {
      cleanSlug = undefined
    }

    return {
      params: { slug: cleanSlug },
      props: { entry },
    }
  })
}

interface Props {
  entry: CollectionEntry<"docs">
}

const { entry } = Astro.props

const { Content, headings } = await render(entry)
---

<DocsLayout title={`${entry.data.title} | Glass UI`} description={entry.data.description}>
  <TableOfContents slot="toc" headings={headings} />

  <div>
    <div class="mb-10">
      <H1>
        {entry.data.title}
      </H1>
      {entry.data.description && <P className="mt-4!">{entry.data.description}</P>}
    </div>

    <div class="prose prose-zinc dark:prose-invert max-w-none">
      <Content />
    </div>
  </div>

  <div>
    <DocsPager />
  </div>
</DocsLayout>
