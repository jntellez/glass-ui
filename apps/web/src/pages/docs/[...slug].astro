---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import DocsPager from "@/components/DocsPager.astro";
import { H1 } from "@/components/Typography";
import { P } from "@/components/Typography";

export async function getStaticPaths() {
  const docsEntries = await getCollection("docs");
  return docsEntries.map((entry: CollectionEntry<"docs">) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={`${entry.data.title} | Glass UI`}
  description={entry.data.description}
>
  <TableOfContents slot="toc" headings={headings} />

  <div>
    <div class="mb-10">
      <H1>
        {entry.data.title}
      </H1>
      {
        entry.data.description && (
          <P className="mt-4!">{entry.data.description}</P>
        )
      }
    </div>

    <div class="prose prose-zinc dark:prose-invert max-w-none">
      <Content />
    </div>
  </div>

  <div>
    <DocsPager />
  </div>
</DocsLayout>
