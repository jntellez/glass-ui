---
import { CustomizationApp } from "@/components/customization/CustomizationApp"
import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="Customization editor - Glass UI"
  description="Tune the canonical glass tokens, preview them locally, and export deterministic CSS."
  bodyClass="h-screen overflow-hidden"
  class="min-h-0 overflow-hidden px-2 mb-2"
>
  <section
    aria-labelledby="customization-title"
    aria-describedby="customization-description"
    class="flex min-h-0 w-full flex-1 flex-col pt-6 overflow-hidden"
  >
    <CustomizationApp client:load />
  </section>
</Layout>
