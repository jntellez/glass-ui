---
import { CustomizationApp } from "@/components/customization/CustomizationApp"
import Layout from "@/layouts/Layout.astro"
import { CUSTOMIZATION_PAGE_DESCRIPTION, CUSTOMIZATION_PAGE_TITLE } from "@/lib/customization-page"
---

<Layout
  title={CUSTOMIZATION_PAGE_TITLE}
  description={CUSTOMIZATION_PAGE_DESCRIPTION}
  bodyClass="h-screen overflow-hidden"
  class="min-h-0 overflow-hidden px-2 mb-2"
>
  <section class="flex min-h-0 w-full flex-1 flex-col overflow-hidden pt-6">
    <CustomizationApp client:load />
  </section>
</Layout>
