---
import { CustomizationApp } from "@/components/customization/CustomizationApp"
import {
  CUSTOMIZATION_PAGE_DESCRIPTION,
  CUSTOMIZATION_PAGE_TITLE,
  getCustomizationPageA11yProps,
  getCustomizationPageSectionClassName,
} from "@/components/customization/customization-page"
import Layout from "@/layouts/Layout.astro"

const pageA11y = getCustomizationPageA11yProps()
---

<Layout title={CUSTOMIZATION_PAGE_TITLE} description={CUSTOMIZATION_PAGE_DESCRIPTION}>
  <section
    aria-labelledby={pageA11y.labelledBy}
    aria-describedby={pageA11y.describedBy}
    class={getCustomizationPageSectionClassName()}
  >
    <CustomizationApp client:load />
  </section>
</Layout>
