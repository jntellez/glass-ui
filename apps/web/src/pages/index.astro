---
import "../styles/global.css";
// Direct import from the source package via workspace
import { Card, Button, Input, Badge } from "@glass-ui-kit/glass";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Glass UI - Registry & Validation</title>

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased p-8 md:p-20">
    <main class="max-w-4xl mx-auto space-y-12">
      <Card className="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">Glass UI Kit</h1>
          <p class="text-sm opacity-70">Registry & Visual Validation System</p>
        </div>

        <Button id="theme-toggle" className="">Toggle Theme</Button>
      </Card>
      <div class="grid
        grid-cols-1
        md:grid-cols-2
        gap-8">
        <section class="space-y-4">
          <h2 class="text-lg font-semibold opacity-80">Registry Status</h2>
          <div
            class="p-4 rounded-xl bg-black/5 dark:bg-white/5 font-mono text-xs"
          >
            <p>
              Endpoint: <a href="/registry.json" class="underline text-blue-500"
                >/registry.json</a
              >
            </p>
            <p class="mt-2 text-green-600 dark:text-green-400">
              ● Serving Static JSON
            </p>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold opacity-80">Component: Badge</h2>

          <Card className="w-full max-w-sm space-y-4">
            <h3 class="font-semibold text-lg">Badge Preview</h3>
            <div class="flex flex-wrap gap-2">
              <Button>Button</Button>
              <Badge>Default</Badge>
              <Badge className="glass">Glass</Badge>
              <Badge className="glass glass-strong">Strong</Badge>
              <Badge className="glass glass-soft">Soft</Badge>
            </div>
          </Card>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold opacity-80">Component: Input</h2>

          <Card className="w-full max-w-sm space-y-4">
            <h3 class="font-semibold text-lg">Input Preview</h3>
            <Input placeholder="Placeholder" />
            <Button>Submit</Button>
          </Card>
        </section>
      </div>
    </main>

    <script>
      const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");

        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      };

      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", handleToggleClick);
    </script>
  </body>
</html>
