---
import Layout from "@/layouts/Layout.astro"
import { Badge, Button } from "@glass-ui-kit/glass"
import ExternalLink from "@/components/docs/ExternalLink"
---

<Layout title="Glass UI - Modern Component Library">
  <div class="flex flex-1 flex-col items-center justify-between w-full">
    {/* Hero Section */}
    <section
      class="flex flex-col items-center justify-center px-4 pt-20 text-center relative overflow-hidden"
    >
      <a href="/docs/getting-started/cli" class="mb-3">
        <Badge className="glass glass-soft px-2.5 py-1">
          <span class="flex h-2 w-2 rounded-full bg-zinc-900 dark:bg-zinc-100 mr-2 animate-pulse"
          ></span>
          Introducing glass-ui/cli
        </Badge>
      </a>

      <h1
        class="max-w-4xl text-4xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-5xl md:text-6xl lg:text-6xl text-balance"
      >
        Interfaces that blend with <br class="hidden md:block" />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-foreground/90 to-muted-foreground/70"
        >
          adaptive physics.
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-md text-muted-foreground sm:text-lg text-balance">
        A beautiful, accessible, and customizable design system engineered for the modern web.
      </p>

      <div class="mt-8 flex items-center justify-center gap-4 w-full sm:w-auto z-10">
        <a href="/docs/installation">
          <Button className="glass glass-strong">Get started</Button>
        </a>

        <a href="/docs/components">
          <Button className="glass glass-soft">View components</Button>
        </a>
      </div>
    </section>

    {/* Footer */}
    <footer class="p-4">
      <p class="text-sm text-muted-foreground text-center">
        Built by <ExternalLink href="https://jntellez.dev">jntellez</ExternalLink>. The source code
        is available on <ExternalLink href="https://github.com/jntellez/glass-ui"
          >GitHub</ExternalLink
        >.
      </p>
    </footer>
  </div>
</Layout>
