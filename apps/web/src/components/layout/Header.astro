---
import DocsCommand from "@/components/layout/DocsCommand.tsx"
import ThemeToggle from "@/components/theme/ThemeToggle.tsx"
import { getHeaderNavigation, HEADER_NAV_BUTTON_CLASS_NAME } from "@/components/layout/nav"
import Button from "@/components/ui/Button.astro"
import { SiGithub } from "@icons-pack/react-simple-icons"

const pathname = Astro.url.pathname
const navigation = getHeaderNavigation(pathname)
---

<header class="glass glass-soft top-2 sticky rounded-glass-md mx-2 z-50">
  <div class="pl-1 pr-4 md:px-8 h-15 flex items-center">
    <div class="flex items-center">
      <Button
        asChild
        variant="ghost"
        className="h-8 text-base font-bold px-3 hover:border-transparent hover:glass"
      >
        <a href="/">Glass UI</a>
      </Button>

      <nav class={navigation.mobile.className}>
        {
          navigation.mobile.links.map((item) => (
            <Button asChild variant="ghost" className={HEADER_NAV_BUTTON_CLASS_NAME}>
              <a href={item.href} aria-current={item.ariaCurrent}>
                {item.label}
              </a>
            </Button>
          ))
        }
      </nav>

      <nav class={navigation.desktop.className}>
        {
          navigation.desktop.links.map((item) => (
            <Button asChild variant="ghost" className={HEADER_NAV_BUTTON_CLASS_NAME}>
              <a href={item.href} aria-current={item.ariaCurrent}>
                {item.label}
              </a>
            </Button>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-1 items-center justify-end gap-3">
      <DocsCommand client:load />

      <Button asChild variant="transparent" size="icon">
        <a href="https://github.com/jntellez/glass-ui" target="_blank" rel="noreferrer">
          <SiGithub />
        </a>
      </Button>

      <ThemeToggle client:load />
    </div>
  </div>
</header>
