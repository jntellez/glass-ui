---
import ThemeToggle from "@/components/theme/ThemeToggle.tsx"
import { getNavAriaCurrent } from "@/components/layout/nav"
import Button from "@/components/ui/Button.astro"
import { SiGithub } from "@icons-pack/react-simple-icons"

const pathname = Astro.url.pathname
---

<header class="glass glass-soft top-2 sticky rounded-glass-md mx-2 z-50">
  <div class="pl-1 pr-4 md:px-8 h-15 flex items-center">
    <div class="flex items-center">
      <Button
        asChild
        variant="ghost"
        className="h-8 text-base font-bold px-3 hover:border-transparent hover:glass"
      >
        <a href="/">Glass UI</a>
      </Button>

      <nav class="hidden sm:flex items-center font-medium text-foreground">
        <Button asChild variant="ghost" className="hover:border-transparent hover:glass px-3">
          <a href="/docs">Docs</a>
        </Button>
        <Button asChild variant="ghost" className="hover:border-transparent hover:glass px-3">
          <a href="/docs/components">Components</a>
        </Button>
        <Button asChild variant="ghost" className="hover:border-transparent hover:glass px-3">
          <a href="/customization" aria-current={getNavAriaCurrent(pathname, "/customization")}
            >Customization</a
          >
        </Button>
      </nav>
    </div>

    <div class="flex flex-1 items-center justify-end gap-3">
      <Button
        variant="transparent"
        className="hidden md:inline-flex items-center font-normal hover:scale-none pr-20 md:pr-26"
      >
        <span class="lg:hidden">Search...</span>
        <span class="hidden lg:inline">Search documentation...</span>
      </Button>

      <Button asChild variant="transparent" size="icon">
        <a href="https://github.com/jntellez/glass-ui" target="_blank" rel="noreferrer">
          <SiGithub />
        </a>
      </Button>

      <ThemeToggle client:load />
    </div>
  </div>
</header>
