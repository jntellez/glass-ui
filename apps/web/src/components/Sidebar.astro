---
import { Button } from "@glass-ui-kit/glass";
import { sidebarNav } from "@/config/docs";

const pathname = Astro.url.pathname;
---

<aside
  class="fixed top-[57px] z-30 hidden h-[calc(100vh-57px)] w-full shrink-0 overflow-y-auto border-r border-glass-border lg:sticky lg:block px-4 py-6 lg:py-8 pb-20 no-scrollbar"
>
  <nav class="flex flex-col gap-6 w-full pr-2">
    {
      sidebarNav.map((group) => (
        <div class="flex flex-col gap-2">
          <h4 class="text-sm text-muted-foreground px-3">{group.title}</h4>

          <div class="flex flex-col gap-1 text-sm">
            {group.items.map((item) => {
              const normalizedPath = pathname.endsWith("/")
                ? pathname.slice(0, -1)
                : pathname;
              const normalizedHref = item.href.endsWith("/")
                ? item.href.slice(0, -1)
                : item.href;

              const isActive =
                normalizedPath === normalizedHref ||
                normalizedPath.startsWith(normalizedHref + "/");

              return (
                <a href={item.href}>
                  <Button
                    className={`text-foreground h-7.5 border-none shadow-none hover:shadow-none px-3 ${isActive && "glass"}`}
                  >
                    {item.title}
                  </Button>
                </a>
              );
            })}
          </div>
        </div>
      ))
    }
  </nav>
</aside>
