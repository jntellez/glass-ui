---
import { Code } from "astro:components";
import CopyButton from "@/components/CopyButton";
import { Card } from "@glass-ui-kit/glass";

export interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang = "tsx", filename } = Astro.props;
---

<Card className="relative p-0 my-6 overflow-hidden">
  <CopyButton code={code} client:visible />

  {
    filename && (
      <div class="border-b border-glass-border px-4 py-1.5">
        <span class="font-mono text-sm text-foreground">{filename}</span>
      </div>
    )
  }

  <div
    class:list={[
      "overflow-x-auto pr-6",
      filename ? "p-4 show-line-numbers" : "p-4",
    ]}
  >
    <Code
      code={code}
      lang={lang as any}
      themes={{
        light: "github-light",
        dark: "github-dark",
      }}
      class="bg-transparent! p-0!"
    />
  </div>
</Card>

<style>
  :global(pre.astro-code) {
    background-color: transparent !important;
    margin: 0 !important;
  }

  :global(.dark .astro-code),
  :global(.dark .astro-code span) {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  :global(.show-line-numbers pre.astro-code code) {
    counter-reset: step;
    counter-increment: step 0;
  }

  :global(.show-line-numbers pre.astro-code code .line::before) {
    content: counter(step);
    counter-increment: step;

    width: 1.2rem;
    margin-right: 1.4rem;
    display: inline-block;
    text-align: right;
    font-size: 0.85rem;

    color: var(--foreground);
    opacity: 0.6;
  }
</style>
