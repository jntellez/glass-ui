---
import { flattenedDocs, installationDocs, darkModeDocs, sidebarNav } from "@/config/docs"
import { Button } from "@glass-ui-kit/glass"
import { Icon } from "astro-icon/components"

const currentPath = Astro.url.pathname.replace(/\/$/, "")

const componentDocs = sidebarNav.find((sec) => sec.title === "Components")?.items || []

const isolatedGroups = [
  {
    prefix: "/docs/installation/",
    items: installationDocs,
    parent: { title: "Installation", href: "/docs/installation" },
  },
  {
    prefix: "/docs/dark-mode/",
    items: darkModeDocs,
    parent: { title: "Dark Mode", href: "/docs/dark-mode" },
  },
  {
    prefix: "/docs/components/",
    items: componentDocs,
    parent: { title: "Components", href: "/docs/components" },
  },
]

const activeGroup = isolatedGroups.find(
  (group) =>
    currentPath.startsWith(group.prefix) && group.items.some((item) => item.href === currentPath),
)

const activeDocsList = activeGroup ? activeGroup.items : flattenedDocs

const currentIndex = activeDocsList.findIndex((item) => item.href === currentPath)

const prev =
  currentIndex > 0
    ? activeDocsList[currentIndex - 1]
    : activeGroup && currentIndex === 0
      ? activeGroup.parent
      : null

const next =
  currentIndex !== -1 && currentIndex < activeDocsList.length - 1
    ? activeDocsList[currentIndex + 1]
    : null
---

<div class="flex flex-row items-center justify-between mt-14 mb-8">
  {
    prev ? (
      <a href={prev.href}>
        <Button className="glass glass-soft">
          <Icon name="lucide:chevron-left" class="w-4 h-4" />
          {prev.title}
        </Button>
      </a>
    ) : (
      <div />
    )
  }

  {
    next && (
      <a href={next.href}>
        <Button className="glass glass-soft">
          {next.title}
          <Icon name="lucide:chevron-right" class="w-4 h-4" />
        </Button>
      </a>
    )
  }
</div>
